[Unit]
Description=Apply staged pi-velvetronix release

[Service]
Type=oneshot
ExecStart=/usr/local/lib/pi-velvetronix/apply-update
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/pi-velvetronix /var/lib/pi-velvetronix /var/lib/pi-velvetronix-update
