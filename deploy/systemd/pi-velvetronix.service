[Unit]
Description=pi-velvetronix (VOX Valvetronix web bridge)
After=network.target NetworkManager.service avahi-daemon.service sound.target
Wants=avahi-daemon.service
# Never stop retrying; rollback logic lives in the boot guard.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=pi-velvetronix
Group=pi-velvetronix
SupplementaryGroups=audio
# '+' = runs as root without sandbox; counts attempts / rolls back pending release.
ExecStartPre=+/usr/local/lib/pi-velvetronix/boot-guard
ExecStart=/opt/pi-velvetronix/current/pi-velvetronix --listen=:80 --state=/var/lib/pi-velvetronix
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s
# "Must confirm within N seconds": READY=1 only after the loopback health check.
TimeoutStartSec=60s
WatchdogSec=30s
TimeoutStopSec=10s

StateDirectory=pi-velvetronix
StateDirectoryMode=0750
UMask=0027

# Port 80 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=char-alsa rw

[Install]
WantedBy=multi-user.target
