// Grants the NetworkManager actions the pi-velvetronix daemon needs (Wi-Fi scan,
// connect, hotspot, profile edits). polkitd 126 uses duktape: ECMAScript 5 only.
polkit.addRule(function (action, subject) {
    // Matched by user only: polkitd 126 on the Pi does not fill subject.system_unit /
    // no_new_privileges for nmcli run by the service (tested 2026-10-19).
    if (subject.user !== "pi-velvetronix") { return polkit.Result.NOT_HANDLED; }
    var allowed = [
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.wifi.scan",
        "org.freedesktop.NetworkManager.wifi.share.protected",
        "org.freedesktop.NetworkManager.wifi.share.open",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.enable-disable-wifi"
    ];
    if (allowed.indexOf(action.id) >= 0) { return polkit.Result.YES; }
    return polkit.Result.NOT_HANDLED;
});
